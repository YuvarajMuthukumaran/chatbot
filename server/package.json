{
  "name": "yuvaraj-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tulasi backend - crisis detection, booking and patient-record flows, and the Groq LLM proxy for Tulasi Health Care's mental health companion",
  "main": "index.js",
  "engines": {
    "node": ">=22.3"
  },
  "scripts": {
    "dev": "node --watch index.js",
    "dev:sandbox": "node --watch scripts/sandbox.js",
    "start": "node index.js",
    "import-doctors": "node scripts/importDoctors.js",
    "test": "node --experimental-test-module-mocks --import ./test/setup.mjs --test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mongodb": "^7.6.0",
    "nodemailer": "^10.0.15",
    "openai": "^4.104.0"
  }
}
