# Copy this file to .env and fill in real values. Never commit .env.

# Server-side only — never expose this to client-side code.
GROQ_API_KEY=your_groq_api_key_here

# Confirm the current model id / free-tier availability in your Groq
# console before launch — https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated models to fall back to, in order, if the primary model
# returns 429/502/503/504 (rate-limited or overloaded). Groq's free tier
# applies rate limits per model, so a different model is usually still
# available even if the primary is temporarily throttled.
GROQ_MODEL_FALLBACKS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# How many recent turns (user+model messages) to replay to the model each
# call. Bounds latency/token cost as a conversation grows.
MAX_HISTORY_TURNS=20

# Port the Express server listens on.
PORT=8788

# Comma-separated list of origins allowed to call this API.
CLIENT_ORIGIN=http://localhost:5173

# Default region for crisis hotline numbers shown to users.
# Supported: IN, US, UK, AU (see server/lib/crisisResources.js)
CRISIS_REGION=IN
