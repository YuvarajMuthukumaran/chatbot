# Copy this file to .env and fill in real values. Never commit .env.

# --- Credentials ------------------------------------------------------------
# Required. Set these here locally and in the host's environment settings in
# production. Never paste them into the code: the repository is public.

# Server-side only — never expose this to client-side code.
GROQ_API_KEY=your_groq_api_key_here

# MongoDB connection string (Atlas: Database > Connect > Drivers). If your
# network blocks the DNS lookups mongodb+srv:// needs, use the direct
# mongodb://host1,host2,host3/?replicaSet=...&tls=true form instead.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?appName=Cluster0
MONGODB_DB=tulasi_test

# --- LLM ----------------------------------------------------------------------

# Confirm the current model id / free-tier availability in your Groq
# console before launch — https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated models to fall back to, in order, if the primary model
# returns 429/502/503/504 (rate-limited or overloaded). Groq's free tier
# applies rate limits per model, so a different model is usually still
# available even if the primary is temporarily throttled.
GROQ_MODEL_FALLBACKS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# How many recent turns (user+model messages) to replay to the model each
# call. Bounds latency/token cost as a conversation grows.
MAX_HISTORY_TURNS=20

# Per-request timeout (ms) before falling back to the next model, sampling
# temperature, and the reply token cap (includes reasoning tokens).
LLM_TIMEOUT_MS=30000
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# --- Server -------------------------------------------------------------------

# Port the Express server listens on.
PORT=8788

# Comma-separated list of origins allowed to call this API.
CLIENT_ORIGIN=http://localhost:5173

# Number of proxy hops in front of the app (Render/Heroku-style hosts: 1;
# exposed directly: 0). Needed so rate limits see real client addresses.
TRUST_PROXY=1

# Enables admin-only endpoints (POST /api/doctors/import) when sent as the
# X-Admin-Token header. Leave unset to keep them switched off.
ADMIN_TOKEN=

# Chat sessions are held in memory; idle ones are forgotten after this long.
SESSION_IDLE_TTL_HOURS=12
MAX_SESSIONS=10000

# --- Clinic -------------------------------------------------------------------

# Default region for crisis hotline numbers shown to users.
# Supported: IN, US, UK, AU (see server/lib/crisisResources.js)
CRISIS_REGION=IN

# "Today" and "has this slot passed" are decided in the clinic's timezone,
# not the server's (hosts usually run in UTC).
CLINIC_TIMEZONE=Asia/Kolkata

# How many days ahead appointments can be booked.
BOOKING_WINDOW_DAYS=90

# --- Tulasi HMS (patient records) --------------------------------------------

# No auth scheme was documented for these endpoints — leave HMS_AUTH_HEADER
# and HMS_AUTH_VALUE blank until confirmed with the HMS/IT team, then fill
# them in (e.g. HMS_AUTH_HEADER=Authorization, HMS_AUTH_VALUE=Bearer ...).
HMS_API_BASE=https://tulasihms.in/hms/api
HMS_AUTH_HEADER=
HMS_AUTH_VALUE=

# --- Website (www.tulasihealthcare.com) ------------------------------------------
# Add the website to CLIENT_ORIGIN above, e.g.
#   CLIENT_ORIGIN=https://www.tulasihealthcare.com,https://chatbot-tulasi.vercel.app

# Patient-portal session cookie, shared by www. and api. subdomains.
COOKIE_DOMAIN=.tulasihealthcare.com
AUTH_SESSION_DAYS=7
# Local http development only: COOKIE_SECURE=false

# Field-level encryption (AES-256-GCM) and keyed lookup hashes for login data.
# Generate each with: openssl rand -base64 32   (required in production)
DATA_ENCRYPTION_KEY=
LOOKUP_HASH_KEY=

# Sandbox/demo only: return the login code in the API response. Never in production.
OTP_DEV_ECHO=false

# --- Notifications (login codes, booking confirmations) ------------------------
# Unset = codes are only logged in development. India SMS needs DLT templates.
SMS_PROVIDER=            # msg91 | twilio
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_BOOKING_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_PROVIDER=       # meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BOOKING_TEMPLATE=
CLINIC_PHONE=+91 8800000255

# --- E-mail (login and booking verification codes, confirmations) ---------------
# Brevo (free plan, sends over HTTPS so it works where SMTP is blocked, e.g. Render's free plan):
# create an API key and verify the sender address in Brevo, then set both in the host's environment.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
# Alternative where SMTP is allowed: a Gmail account plus a Google "App password".
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Tulasi Healthcare
