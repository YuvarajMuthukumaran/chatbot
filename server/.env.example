# Copy this file to .env and fill in real values. Never commit .env.

# --- Credentials ------------------------------------------------------------
# Optional on the test deployment if TEST_GROQ_API_KEY (lib/llmClient.js) and
# TEST_MONGODB_URI (lib/db.js) are filled in; these override them when set.

# Server-side only — never expose this to client-side code.
GROQ_API_KEY=your_groq_api_key_here

# MongoDB connection string (Atlas: Database > Connect > Drivers). If your
# network blocks the DNS lookups mongodb+srv:// needs, use the direct
# mongodb://host1,host2,host3/?replicaSet=...&tls=true form instead.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?appName=Cluster0
MONGODB_DB=tulasi_test

# --- LLM ----------------------------------------------------------------------

# Confirm the current model id / free-tier availability in your Groq
# console before launch — https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated models to fall back to, in order, if the primary model
# returns 429/502/503/504 (rate-limited or overloaded). Groq's free tier
# applies rate limits per model, so a different model is usually still
# available even if the primary is temporarily throttled.
GROQ_MODEL_FALLBACKS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# How many recent turns (user+model messages) to replay to the model each
# call. Bounds latency/token cost as a conversation grows.
MAX_HISTORY_TURNS=20

# --- Server -------------------------------------------------------------------

# Port the Express server listens on.
PORT=8788

# Comma-separated list of origins allowed to call this API.
CLIENT_ORIGIN=http://localhost:5173

# Number of proxy hops in front of the app (Render/Heroku-style hosts: 1;
# exposed directly: 0). Needed so rate limits see real client addresses.
TRUST_PROXY=1

# Enables admin-only endpoints (POST /api/doctors/import) when sent as the
# X-Admin-Token header. Leave unset to keep them switched off.
ADMIN_TOKEN=

# Chat sessions are held in memory; idle ones are forgotten after this long.
SESSION_IDLE_TTL_HOURS=12
MAX_SESSIONS=10000

# --- Clinic -------------------------------------------------------------------

# Default region for crisis hotline numbers shown to users.
# Supported: IN, US, UK, AU (see server/lib/crisisResources.js)
CRISIS_REGION=IN

# "Today" and "has this slot passed" are decided in the clinic's timezone,
# not the server's (hosts usually run in UTC).
CLINIC_TIMEZONE=Asia/Kolkata

# How many days ahead appointments can be booked.
BOOKING_WINDOW_DAYS=90

# --- Tulasi HMS (patient records) --------------------------------------------

# No auth scheme was documented for these endpoints — leave HMS_AUTH_HEADER
# and HMS_AUTH_VALUE blank until confirmed with the HMS/IT team, then fill
# them in (e.g. HMS_AUTH_HEADER=Authorization, HMS_AUTH_VALUE=Bearer ...).
HMS_API_BASE=https://tulasihms.in/hms/api
HMS_AUTH_HEADER=
HMS_AUTH_VALUE=
